# Copy to .env. This file contains examples, not working credentials.
# For local compose choose URL-safe random alphanumeric passwords (32+ characters).
POSTGRES_ADMIN_PASSWORD=replace_with_random_local_admin_password
APP_DB_PASSWORD=replace_with_random_local_app_password
ENVIRONMENT=development
DATABASE_URL=postgresql://app_runtime:replace_with_random_local_app_password@localhost:5432/auralis
REDIS_URL=redis://localhost:6379/0
OIDC_ISSUER=https://YOUR-TENANT.auth0.com/
OIDC_AUDIENCE=https://api.YOUR-DOMAIN.example
CORS_ORIGINS=["http://localhost:4173","http://127.0.0.1:4173"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
TRUSTED_PROXY_CIDRS=[]
RATE_LIMIT_SECRET=replace_with_random_value_at_least_32_characters
METRICS_TOKEN=replace_with_another_random_value_at_least_32_characters
TURNSTILE_SECRET=
TURNSTILE_HOSTNAME=YOUR-FRONTEND-HOST.example
CHECKPOINT_PATH=./models/composer.pt
GENERATION_TIMEOUT_SECONDS=45
GENERATION_CONCURRENCY=1
